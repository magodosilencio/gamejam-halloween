; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/updates_per_second=30

[application]

config/name="Gamejam Halloween IMD"
run/main_scene="uid://dp83flofq3btp"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

WindowManager="*uid://dc78irm4wyt6t"
GameEvents="*uid://b57p5o48tf6w6"
CameraManager="*uid://dg3miukocjyec"
CharacterVoices="*uid://bidpaxjgwrw3p"
DialogueManager="*uid://c3rodes2l3gxb"

[dialogue_manager]

editor/wrap_long_lines=true
runtime/balloon_path="res://systems/dialogue_balloon/dialogue_balloon.tscn"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/resizable=false
window/size/maximize_disabled=true
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

